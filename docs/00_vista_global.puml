@startuml 00_vista_global
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
title EduSaldo · Modelo de dominio — Vista global (4 microservicios)
hide members
hide circle
left to right direction

package "8081 Usuarios y Auth" {
  abstract class Usuario
  class Administrador
  class Encargado
  class Apoderado
  class Alumno
  class ApoderadoAlumno
  class PoliticaAcceso
  class ConfiguracionInstitucional
  class ParametroSistema
  class RegistroAuditoria
  Usuario <|-- Administrador
  Usuario <|-- Encargado
  Usuario <|-- Apoderado
  Usuario <|-- Alumno
  Apoderado "1" -- "0..*" ApoderadoAlumno
  ApoderadoAlumno "1..*" -- "1" Alumno
}

package "8082 Saldos y Abonos" {
  class CuentaSaldo
  class MovimientoSaldo
  class Abono
  class AlertaSaldoBajo
  class DevolucionSaldo
  CuentaSaldo *-- MovimientoSaldo
  CuentaSaldo *-- AlertaSaldoBajo
  CuentaSaldo -- DevolucionSaldo
  Abono ..> MovimientoSaldo
}

package "8083 Productos e Inventario" {
  class Categoria
  class Producto
  class Proveedor
  class IngresoStock
  class DetalleIngresoStock
  class MovimientoInventario
  class SolicitudAjusteStock
  class InventarioFisico
  Categoria -- Producto
  Proveedor -- IngresoStock
  IngresoStock *-- DetalleIngresoStock
  DetalleIngresoStock --> Producto
  Producto *-- MovimientoInventario
  Producto -- SolicitudAjusteStock
  InventarioFisico --> Producto
}

package "8084 Reservas y Entregas" {
  class Reserva
  class DetalleReserva
  class Entrega
  class DetalleEntrega
  class Devolucion
  class NotificacionEntrega
  Reserva *-- DetalleReserva
  Reserva -- Entrega
  Entrega *-- DetalleEntrega
  Entrega -- Devolucion
  Entrega *-- NotificacionEntrega
}

' Referencias entre microservicios: solo por ID (sin relación JPA)
CuentaSaldo ..> Alumno : alumnoId
Abono ..> Apoderado : apoderadoId
Reserva ..> Alumno : alumnoId
Entrega ..> Alumno : alumnoId
NotificacionEntrega ..> Apoderado : apoderadoId
DetalleReserva ..> Producto : productoId
DetalleEntrega ..> Producto : productoId
IngresoStock ..> Encargado : encargadoId

legend right
  ——  relación JPA dentro del microservicio
  ◆——  composición
  △——  herencia
  - - ->  referencia por ID entre microservicios
          (REST + DTO, sin FK entre bases de datos)
  Se eliminaron MS Compras y MS Finanzas.
endlegend
@enduml
