@startuml 00_vista_global
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
title EduSaldo · Modelo de dominio — Vista global (4 microservicios)
hide members
hide circle
left to right direction

package "8081 Usuarios y Auth" {
  abstract class Usuario
  class Administrador
  class Encargado
  class Apoderado
  class Alumno
  class ApoderadoAlumno
  class PoliticaAcceso
  class IntentoAcceso
  class TokenRecuperacion
  class ConsentimientoPrivacidad
  class ConfiguracionInstitucional
  class ParametroSistema
  class RegistroAuditoria
  class ConsultaContacto
  Usuario <|-- Administrador
  Usuario <|-- Encargado
  Usuario <|-- Apoderado
  Usuario <|-- Alumno
  Apoderado "1..*" -- "0..*" Alumno : asociados >
  (Apoderado, Alumno) .. ApoderadoAlumno
  Usuario *-- TokenRecuperacion
  Usuario *-- ConsentimientoPrivacidad
  PoliticaAcceso ..> IntentoAcceso : evalúa
  RegistroAuditoria ..> Usuario : audita
}

package "8082 Saldos y Abonos" {
  class CuentaSaldo
  class MovimientoSaldo
  class Abono
  CuentaSaldo *-- MovimientoSaldo
  Abono ..> CuentaSaldo : acredita en
}

package "8083 Productos e Inventario" {
  class Categoria
  class Producto
  class IngresoStock
  class DetalleIngresoStock
  class MovimientoInventario
  class SolicitudAjusteStock
  Categoria -- Producto
  IngresoStock *-- DetalleIngresoStock
  DetalleIngresoStock --> Producto
  Producto *-- MovimientoInventario
  Producto -- SolicitudAjusteStock
}

package "8084 Reservas y Entregas" {
  class Reserva
  class DetalleReserva
  class Entrega
  class DetalleEntrega
  class Devolucion
  class DetalleDevolucion
  Reserva *-- DetalleReserva
  Reserva -- Entrega
  Entrega *-- DetalleEntrega
  Entrega -- Devolucion
  Devolucion *-- DetalleDevolucion
  DetalleDevolucion --> DetalleEntrega : revierte
}

' Referencias entre microservicios: solo por ID (sin relación JPA)
CuentaSaldo ..> Alumno : alumnoId
Abono ..> Apoderado : apoderadoId
Abono ..> Alumno : alumnoId
Reserva ..> Alumno : alumnoId
Reserva ..> Apoderado : creadaPorId (APO o ALU ≥ 12)
Entrega ..> Alumno : alumnoId
DetalleReserva ..> Producto : productoId
DetalleEntrega ..> Producto : productoId
IngresoStock ..> Encargado : encargadoId

legend right
  ——  relación dentro del microservicio
  ◆——  composición
  △——  herencia
  ..  clase de asociación UML (ApoderadoAlumno)
  - - ->  referencia por ID entre microservicios
          (REST + DTO, sin FK entre bases de datos)
  Otros IDs omitidos por claridad: preparadaPorId / encargadoId
  (Reserva, Entrega, Devolucion → Encargado), solicitanteId y
  administradorId (SolicitudAjusteStock → Encargado / Administrador).
  Ya no forman parte de la arquitectura: MS Compras, MS Finanzas,
  Proveedor, AlertaSaldoBajo, DevolucionSaldo, InventarioFisico,
  NotificacionEntrega, ImportacionNomina.
endlegend
@enduml