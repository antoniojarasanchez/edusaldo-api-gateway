@startuml 00_vista_global
title EduSaldo · Arquitectura General y Bounded Contexts (100% Desacoplados)\nEntrada exclusiva vía API Gateway (Puerto 8099) · Sin comunicación directa entre microservicios
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide members
hide circle
top to bottom direction

package "Punto Único de Entrada" {
  class "API Gateway\n(Puerto 8099)" as GATEWAY <<Spring Cloud Gateway>> #D9E1F2
}

package "8081 Auth y Usuarios (db_auth_usuarios)" as AUTH {
  class Usuario
  class TokenRecuperacion
  class TokenRevocado
  class ConsentimientoPrivacidad
  Usuario *-- TokenRecuperacion
  Usuario -- TokenRevocado
  Usuario *-- ConsentimientoPrivacidad
}

package "8082 Alumnos y Saldos (db_alumnos_saldos)" as ALU {
  class Alumno
  class ApoderadoAlumno
  class CuentaSaldo
  class MovimientoSaldo
  class Abono
  class AlertaSaldoBajo
  class DevolucionSaldo
  class ImportacionNomina
  class DetalleImportacion
  Alumno "1" *-- "1..*" ApoderadoAlumno
  CuentaSaldo *-- AlertaSaldoBajo
  CuentaSaldo -- DevolucionSaldo
  ImportacionNomina *-- DetalleImportacion
  DetalleImportacion --> Alumno
  Alumno *-- CuentaSaldo
  CuentaSaldo *-- MovimientoSaldo
  Alumno -- Abono
}

package "8083 Productos e Inventario (db_productos_inventario)" as PROD {
  class Categoria
  class Producto
  class MovimientoInventario
  class SolicitudAjusteStock
  class InventarioFisico
  class DetalleConteo
  class ReporteDiferenciaStock
  Categoria -- Producto
  Producto *-- MovimientoInventario
  Producto -- SolicitudAjusteStock
  InventarioFisico *-- DetalleConteo
  DetalleConteo --> Producto
  DetalleConteo --> ReporteDiferenciaStock
  ReporteDiferenciaStock --> Producto
  ReporteDiferenciaStock --> SolicitudAjusteStock
}

package "8084 Ventas y Reservas (db_ventas_reservas)" as VEN {
  class Reserva
  class DetalleReserva
  class Venta
  class DetalleVenta
  class Devolucion
  class DetalleDevolucion
  Reserva *-- DetalleReserva
  Reserva -- Venta
  Venta *-- DetalleVenta
  Venta *-- Devolucion
  Devolucion *-- DetalleDevolucion
  DetalleDevolucion --> DetalleVenta
}

package "8085 Compras (db_compras)" as COM {
  class Proveedor
  class OrdenCompra
  class DetalleOrdenCompra
  class Recepcion
  class DetalleRecepcion
  class Factura
  class DetalleFactura
  Proveedor -- OrdenCompra
  Proveedor -- Factura
  OrdenCompra *-- DetalleOrdenCompra
  OrdenCompra -- Recepcion
  Recepcion *-- DetalleRecepcion
  DetalleRecepcion --> DetalleOrdenCompra
  Recepcion "1" *-- "1..*" Factura
  Factura *-- DetalleFactura
  DetalleFactura --> DetalleOrdenCompra
}

package "8086 Finanzas y Configuración (db_finanzas_config)" as FIN {
  class CuentaLibreria
  class MovimientoCaja
  class RegistroResultado
  class ReporteResultados <<DTO>>
  class PeriodoContable
  class FacturaPorPagar
  class ItemFacturaPorPagar
  class SolicitudPago
  class Pago
  class ConfiguracionInstitucional
  class ParametroSistema
  class RegistroAuditoria
  class ConsultaContacto
  CuentaLibreria *-- MovimientoCaja
  PeriodoContable -- MovimientoCaja
  PeriodoContable -- RegistroResultado
  ReporteResultados ..> MovimientoCaja
  ReporteResultados ..> RegistroResultado
  FacturaPorPagar *-- ItemFacturaPorPagar
  FacturaPorPagar -- SolicitudPago
  SolicitudPago -- Pago
  Pago --> MovimientoCaja
}

' Enrutamiento exclusivo hacia los puertos de cada microservicio
GATEWAY --> AUTH : Puerto 8081
GATEWAY --> ALU : Puerto 8082
GATEWAY --> PROD : Puerto 8083
GATEWAY --> VEN : Puerto 8084
GATEWAY --> COM : Puerto 8085
GATEWAY --> FIN : Puerto 8086

legend right
  Topología en Estrella (Hub & Spoke):
  • Cada microservicio es 100% autónomo con su propia base de datos.
  • Cero dependencias directas entre microservicios.
  • Referencias a otras entidades se guardan únicamente
    como IDs numéricos escalares (Long alumnoId, Long productoId),
    sin FKs JPA ni llamadas remotas entre sí.
  • El Gateway (8099) centraliza el acceso desde React y enruta
    hacia los puertos oficiales (8081 a 8086) definidos en arquitectura.
endlegend
@enduml
